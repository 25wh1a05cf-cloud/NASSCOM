      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "\n",
        "np.random.seed(42)\n",
        "print('Setup complete. NumPy', np.__version__)\n",
        ""
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "rolls = np.random.randint(1, 7, size=100_000)   # 100k dice rolls\n",
        "\n",
        "p_even = (rolls % 2 == 0).mean()       # P(even)\n",
        "p_gt4  = (rolls > 4).mean()            # P(roll > 4)\n",
        "print('P(even) ~', round(p_even, 3), ' (true 0.5)')\n",
        "print('P(>4)   ~', round(p_gt4, 3),  ' (true 0.333)')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hH112QDBt61V",
        "outputId": "4bdb74fd-3287-4787-bc35-de7d10be1101"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(even) ~ 0.502  (true 0.5)\n",
            "P(>4)   ~ 0.334  (true 0.333)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "p_1 = (rolls == 1).mean()\n",
        "p_2 = (rolls == 2).mean()\n",
        "p_1_or_2 = (np.isin(rolls, [1, 2])).mean()\n",
        "print('P(1) + P(2) =', round(p_1 + p_2, 3))\n",
        "print('P(1 or 2)   =', round(p_1_or_2, 3), ' -> they match')\n",
        ""
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "UiVRUXZeuAB8",
        "outputId": "e9b11bd8-71ac-4702-8d89-b9104d8f81af"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(1) + P(2) = 0.334\n",
            "P(1 or 2)   = 0.334  -> they match\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "flips = np.random.randint(0, 2, size=(100_000, 2))\n",
        "\n",
        "heads = flips.sum(axis=1)\n",
        "\n",
        "\n",
        "p_both_heads = np.mean(heads == 2)\n",
        "print(\"P(both heads):\", p_both_heads)\n",
        "\n",
        "\n",
        "p_at_least_one = np.mean(heads >= 1)\n",
        "print(\"P(at least one head):\", p_at_least_one)\n",
        "\n",
        "\n",
        "p_0 = np.mean(heads == 0)\n",
        "p_1 = np.mean(heads == 1)\n",
        "p_2 = np.mean(heads == 2)\n",
        "\n",
        "print(\"P(0 heads) + P(1 head) + P(2 heads):\", p_0 + p_1 + p_2)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0UsrgJq1uDBc",
        "outputId": "d9660b80-7bab-43a1-d020-26e2d72aaa9f"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(both heads): 0.25198\n",
            "P(at least one head): 0.74932\n",
            "P(0 heads) + P(1 head) + P(2 heads): 1.0\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "rolls = np.random.randint(1, 7, size=100_000)\n",
        "\n",
        "even = rolls[rolls % 2 == 0]\n",
        "p_6_given_even = (even == 6).mean()\n",
        "print('P(6 | even) ~', round(p_6_given_even, 3), ' (true 1/3)')\n",
        ""
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_4gPpHWquOrG",
        "outputId": "d54f0abd-223e-4193-ad98-b4461170e23a"
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(6 | even) ~ 0.332  (true 1/3)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "A = rolls > 3\n",
        "B = rolls % 2 == 0\n",
        "p_A        = A.mean()\n",
        "p_A_given_B = A[B].mean()\n",
        "print('P(A)      =', round(p_A, 3))\n",
        "print('P(A | B)  =', round(p_A_given_B, 3))\n",
        "print('Independent?', np.isclose(p_A, p_A_given_B, atol=0.02))\n",
        ""
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MwbCPUsRuVVd",
        "outputId": "cca29931-cf1d-481d-ab19-82d78e3402f3"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(A)      = 0.498\n",
            "P(A | B)  = 0.666\n",
            "Independent? False\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "rolls = np.random.randint(1, 7, size=100_000)\n",
        "\n",
        "\n",
        "condition = rolls < 4\n",
        "p_odd_given_less4 = np.mean(rolls[condition] % 2 == 1)\n",
        "print(\"P(odd | roll < 4):\", p_odd_given_less4)\n",
        "\n",
        "p_less4 = np.mean(rolls < 4)\n",
        "print(\"P(roll < 4):\", p_less4)\n",
        "\n",
        "p_odd = np.mean(rolls % 2 == 1)\n",
        "print(\"P(odd):\", p_odd)\n",
        "\n",
        "if np.isclose(p_odd_given_less4, p_odd):\n",
        "    print(\"Approximately independent\")\n",
        "else:\n",
        "    print(\"Not independent\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
