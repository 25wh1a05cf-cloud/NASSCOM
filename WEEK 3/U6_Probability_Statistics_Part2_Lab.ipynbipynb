    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.stats import entropy\n",
        "\n",
        "# Probability distributions\n",
        "fair = [0.5, 0.5]\n",
        "biased = [0.9, 0.1]\n",
        "certain = [1.0, 0.0]\n",
        "\n",
        "# Entropy in BITS\n",
        "print('Entropy fair coin   :', round(entropy(fair, base=2), 3), 'bits')\n",
        "print('Entropy biased coin :', round(entropy(biased, base=2), 3), 'bits')\n",
        "print('Entropy certain     :', round(entropy(certain, base=2), 3), 'bits')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "u9x2Ryz4vo2a",
        "outputId": "42b4ac06-3ab7-4b9a-c673-fe5a552fcc94"
      },
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Entropy fair coin   : 1.0 bits\n",
            "Entropy biased coin : 0.469 bits\n",
            "Entropy certain     : 0.0 bits\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "P = np.array([0.5, 0.5])\n",
        "Q = np.array([0.9, 0.1])\n",
        "\n",
        "# scipy's entropy(P, Q) computes the KL divergence D(P || Q)\n",
        "print('D(P || Q) =', round(entropy(P, Q, base=2), 3), 'bits')\n",
        "print('D(P || P) =', round(entropy(P, P, base=2), 3), '-> zero (identical)')\n",
        "print('Note: D(P||Q) != D(Q||P)  ->', round(entropy(Q, P, base=2), 3), '(not symmetric)')\n",
        "\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jW4jTYZhvtRS",
        "outputId": "82b25c46-ae3b-40b1-b22b-c0dacc26901f"
      },
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "D(P || Q) = 0.737 bits\n",
            "D(P || P) = 0.0 -> zero (identical)\n",
            "Note: D(P||Q) != D(Q||P)  -> 0.531 (not symmetric)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.feature_selection import mutual_info_classif\n",
        "from sklearn.datasets import load_iris\n",
        "\n",
        "iris = load_iris()\n",
        "mi = mutual_info_classif(iris.data, iris.target, random_state=0)\n",
        "for name, score in sorted(zip(iris.feature_names, mi), key=lambda t: -t[1]):\n",
        "    print(f'{score:.3f}  {name}')\n",
        "print('-> higher MI = the feature tells us more about the class')\n",
        ""
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8PnJGq41vyEC",
        "outputId": "dd9bfda5-dd10-4151-8ea1-ae0ce7a7d1cb"
      },
      "execution_count": 23,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0.990  petal length (cm)\n",
            "0.975  petal width (cm)\n",
            "0.474  sepal length (cm)\n",
            "0.286  sepal width (cm)\n",
            "-> higher MI = the feature tells us more about the class\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.stats import entropy\n",
        "\n",
        "# 1. Entropy of a fair 4-sided and 6-sided die\n",
        "die4 = [1/4] * 4\n",
        "die6 = [1/6] * 6\n",
        "\n",
        "H4 = entropy(die4, base=2)\n",
        "H6 = entropy(die6, base=2)\n",
        "\n",
        "print(\"Entropy of 4-sided die:\", round(H4, 3), \"bits\")\n",
        "print(\"Entropy of 6-sided die:\", round(H6, 3), \"bits\")\n",
        "\n",
        "if H6 > H4:\n",
        "    print(\"6-sided die is more uncertain\")\n",
        "else:\n",
        "    print(\"4-sided die is more uncertain\")\n",
        "\n",
        "\n",
        "# 2. KL divergence D(P || Q)\n",
        "P = np.array([0.7, 0.3])\n",
        "Q = np.array([0.5, 0.5])\n",
        "\n",
        "kl = entropy(P, Q)\n",
        "\n",
        "print(\"KL Divergence D(P || Q):\", round(kl, 3))\n",
        "\n",
        "\n",
        "# 3. Most / least informative Iris feature\n",
        "# From the MI scores in your previous exercise:\n",
        "print(\"Most informative: petal length\")\n",
        "print(\"Least informative: sepal width\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "G9TUFXfpvzqz",
        "outputId": "ff5db048-8605-45e0-da01-1d14e69a2540"
      },
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Entropy of 4-sided die: 2.0 bits\n",
            "Entropy of 6-sided die: 2.585 bits\n",
            "6-sided die is more uncertain\n",
            "KL Divergence D(P || Q): 0.082\n",
            "Most informative: petal length\n",
            "Least informative: sepal width\n"
          ]
        }
      ]
    }
  ]
