    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import norm\n",
        "\n",
        "# 1. Draw 10,000 samples from Poisson distribution with mean = 2\n",
        "samples = np.random.poisson(2, size=10_000)\n",
        "\n",
        "print(\"Sample mean:\", np.mean(samples))\n",
        "\n",
        "\n",
        "# 2. Plot histogram of Poisson samples\n",
        "plt.hist(samples, bins=np.arange(-0.5, max(samples) + 1.5, 1), edgecolor=\"black\")\n",
        "\n",
        "plt.xlabel(\"Number of events\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.title(\"Poisson Distribution (mu = 2)\")\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 3. Plot Gaussian PDF for mu = 0 with two different sigmas\n",
        "x = np.linspace(-5, 5, 1000)\n",
        "\n",
        "pdf1 = norm.pdf(x, 0, 1)   # mean = 0, sigma = 1\n",
        "pdf2 = norm.pdf(x, 0, 2)   # mean = 0, sigma = 2\n",
        "\n",
        "plt.plot(x, pdf1, label=\"sigma = 1\")\n",
        "plt.plot(x, pdf2, label=\"sigma = 2\")\n",
        "\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"Probability Density\")\n",
        "plt.title(\"Gaussian PDF for Different Sigma Values\")\n",
        "plt.legend()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 944
