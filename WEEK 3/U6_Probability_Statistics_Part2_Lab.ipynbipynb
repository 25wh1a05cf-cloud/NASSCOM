          "text": [
            "P(odd | roll < 4): 0.667995991983968\n",
            "P(roll < 4): 0.499\n",
            "P(odd): 0.50253\n",
            "Not independent\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "p_disease   = 0.01\n",
        "p_pos_given_D  = 0.99\n",
        "p_pos_given_nD = 0.01\n",
        "\n",
        "p_pos = p_pos_given_D * p_disease + p_pos_given_nD * (1 - p_disease)\n",
        "\n",
        "p_D_given_pos = (p_pos_given_D * p_disease) / p_pos\n",
        "print('P(sick | positive test) =', round(p_D_given_pos, 3))\n",
        "print('-> only ~50%, because the disease is rare (base-rate effect)')\n",
        "\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "xVyufvqKue-G",
        "outputId": "07089f83-0141-468e-8e83-fccfb419c3fe"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "P(sick | positive test) = 0.5\n",
            "-> only ~50%, because the disease is rare (base-rate effect)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "N = 1_000_000\n",
        "has_disease = np.random.rand(N) < p_disease\n",
        "\n",
        "tests_pos = np.where(has_disease,\n",
        "                     np.random.rand(N) < p_pos_given_D,\n",
        "                     np.random.rand(N) < p_pos_given_nD)\n",
        "among_positive = has_disease[tests_pos]\n",
        "print('Simulated P(sick | positive) =', round(among_positive.mean(), 3))\n",
        "\n"
      ],
      "metadata": {
